#!/bin/bash
set -e

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV_DIR="$PROJECT_DIR/.venv"
CLI_SCRIPT="$PROJECT_DIR/core.py"
# 记录调用者目录: core 常驻在项目根, 模块需要时可从 T.CLIENT_CWD 取
CLIENT_CWD="${SUN_CLIENT_CWD:-$PWD}"
# pip 下载源: 默认用清华镜像, 可用 SUN_PIP_INDEX 覆盖
PIP_INDEX="${SUN_PIP_INDEX:-https://pypi.tuna.tsinghua.edu.cn/simple}"
PIP_HOST="$(echo "$PIP_INDEX" | sed -E 's#^https?://([^/:]+).*#\1#')"
PIP_OPTS=(--index-url "$PIP_INDEX" --trusted-host "$PIP_HOST")

# 首次运行：自动创建 venv 并安装依赖
if [ ! -d "$VENV_DIR" ]; then
    echo "[sun] 首次运行，准备虚拟环境..."
    
    if ! command -v python3 &> /dev/null; then
        echo "错误：未找到 python3，请先安装 Python 3"
        exit 1
    fi
    
    python3 -m venv "$VENV_DIR" || {
        echo "错误: 虚拟环境创建失败, Ubuntu/Debian 请先安装: sudo apt install python3-venv"
        exit 1
    }
    echo "[sun] 升级 pip 并安装依赖(源: $PIP_INDEX) ..."
    "$VENV_DIR/bin/pip" install --upgrade pip "${PIP_OPTS[@]}"
    if [ -f "$PROJECT_DIR/requirements.txt" ]; then
        "$VENV_DIR/bin/pip" install -r "$PROJECT_DIR/requirements.txt" "${PIP_OPTS[@]}"
    fi
    echo "[sun] 虚拟环境就绪"
fi

# 进入项目目录, 保证模块内的相对路径(如 ./data)有效
cd "$PROJECT_DIR"
export SUN_CLIENT_CWD="$CLIENT_CWD"

# 用 venv 的 Python 执行 core 客户端, 透传所有参数
exec "$VENV_DIR/bin/python" "$CLI_SCRIPT" --client "$@"